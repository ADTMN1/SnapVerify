# SnapVerify Admin Panel — environment variables.
#
# Copy to .env for local development, or set VITE_API_URL in your hosting
# platform dashboard for staging/production.
#
# Vite only exposes variables prefixed with VITE_ to the client code.
# Never put secrets here — this file is bundled into the frontend.

# Local development (backend running on localhost)
VITE_API_URL=http://localhost:3000
