# SnapVerify backend — production environment template.
# Copy to .env and fill in real values. NEVER commit the real .env.

# ── Runtime ─────────────────────────────────────────────────────────────────
# Must be "production" in prod: enables fail-fast secret checks and disables
# dev-only behaviors.
NODE_ENV="production"
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────
# Local dev:      postgresql://user:password@localhost:5432/snapverify
# Supabase (prod): use the SHARED SESSION POOLER, not the direct host.
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#   * direct host db.<project-ref>.supabase.co is IPv6-only (no paid IPv4
#     add-on) and Render has no outbound IPv6 → ENOTFOUND
#   * transaction mode (port 6543) does not support prepared statements
DATABASE_URL="postgresql://user:password@host:5432/snapverify?sslmode=require"
# TLS for the PostgreSQL pool. Defaults preserve managed-provider behavior
# (encrypted, certificate NOT verified). Tighten with — and only with — a
# provider whose chain validates:
#   DATABASE_SSL_REJECT_UNAUTHORIZED=true
#   DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----..."   (optional explicit CA)
# Local development only (no TLS at all):
#   DATABASE_SSL=disable

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64  (both must be unique)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Explicit trusted-origin allow-list. Wildcard ("*") is rejected at startup.
ALLOWED_ORIGINS="https://your-frontend-domain.com"

# Server-side secret for keyed HMAC-SHA-256 hashing of receiving-account
# numbers. Required in production (>= 32 chars).
# Generate with: openssl rand -base64 48
ACCOUNT_HASH_SECRET=""

# Optional: separate signing secret for the admin console (>= 32 chars).
# Falls back to JWT_ACCESS_SECRET when unset.
# JWT_ADMIN_ACCESS_SECRET=""

# Optional: enable credentialed CORS (default false). Requires an explicit
# ALLOWED_ORIGINS list; "*" is still rejected.
# ALLOW_CREDENTIALS=false

# ── Payment verification (Check.et) ────────────────────────────────────────
CHECK_ET_BASE_URL="https://api.check.et"
CHECK_ET_API_KEY=""
# ── Rate limiting (optional; defaults shown) ───────────────────────────────
# In-memory store: limits are per process, so run a single instance.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# PAYMENT_VERIFY_RATE_LIMIT=60
# PAYMENT_VERIFY_IMAGE_RATE_LIMIT=30
# QR_RESOLVE_RATE_LIMIT=60

# Per-attempt request timeout for Check.et verification calls, in ms.
# Default 45000. Bounded to 5000..120000 to avoid hangs or overly short budgets.
# Retryable network/timeout/5xx/429 failures use up to 3 attempts with bounded
# exponential backoff + jitter; auth/quota/validation/duplicate/authoritative
# answers are never retried.
CHECK_ET_TIMEOUT_MS=45000

# ── Public URLs (HTTPS required in production) ─────────────────────────────
# Base URL of the public backend, used in staff-invitation links.
APP_URL="https://api.your-domain.com"
# Base URL embedded in payment-account QR codes.
QR_PUBLIC_BASE_URL="https://api.your-domain.com"

# ── Email delivery (one transport is REQUIRED in production) ───────────────
# Either Brevo (API key) or an SMTP relay (SMTP_HOST + SMTP_PORT; SMTP_USER /
# SMTP_PASS only when the relay requires authentication). Without one, the
# service would only log emails to the console, so production boot fails.
BREVO_API_KEY=""
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# Optional custom SMS sender name (used only if SMS providers are enabled)
BREVO_SMS_SENDER="SnapVerify"
# Verified sender for outgoing email, e.g. "SnapVerify <no-reply@yourdomain.com>"
EMAIL_FROM="SnapVerify <no-reply@yourdomain.com>"
