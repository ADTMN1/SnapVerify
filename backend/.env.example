# Database
DATABASE_URL="postgresql://user:password@localhost:5432/snapverify?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-use-a-long-random-string-in-production"
JWT_REFRESH_SECRET="change-me-use-a-different-long-random-string-in-production"

# Server
PORT=3000
NODE_ENV="development"

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3001,https://your-admin-dashboard.example.com"

# SMS Provider (AfroMessage)
AFROMESSAGE_API_TOKEN="your-afromessage-api-token"
AFROMESSAGE_BASE_URL="https://api.afromessage.com"

# SMS Provider (SMSEthiopia - Legacy)
SMSETHIOPIA_API_KEY="your-smsethiopia-api-key"

# Verify.leul.et Payment Verification API
VERIFY_API_KEY="your-verify-api-key"
VERIFY_LEUL_ET_BASE_URL="https://verifyapi.leulzenebe.pro"
