# Database
# Neon Postgres connection string. NEVER commit a real value here.
DATABASE_URL="postgresql://user:password@localhost:5432/snapverify?schema=public"

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 random characters. Keep these secrets out of source control.
JWT_ACCESS_SECRET="replace-with-long-random-access-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-long-random-refresh-secret-min-32-chars"

# Server
PORT=3000
NODE_ENV="development"

# CORS — comma-separated list of allowed frontend origins (http/https only).
# Wildcard origins are rejected at startup.
# In production this MUST be set to an explicit allow-list, e.g.:
#   ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Credentialed cross-origin requests. This app uses Bearer-token auth, not
# cookies, so credentials default to OFF. Set to "true" only if credentialed
# requests are actually required, and keep ALLOWED_ORIGINS explicit.
ALLOW_CREDENTIALS="false"

# SMS Provider (AfroMessage)
AFROMESSAGE_API_TOKEN="replace-with-afromessage-api-token"
AFROMESSAGE_BASE_URL="https://api.afromessage.com"

# SMS Provider (SMSEthiopia - Legacy)
SMSETHIOPIA_API_KEY="replace-with-smsethiopia-api-key"

# Twilio (if used)
TWILIO_ACCOUNT_SID="replace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_PHONE_NUMBER="replace-with-twilio-phone-number"

# Rate limiting (Stage 1). All values are positive integers; invalid values
# fail startup. Windows are in MILLISECONDS (@nestjs/throttler v6).
# Limits are enforced per organization for authenticated requests (all staff
# of one merchant share a bucket) and per IP for unauthenticated requests.
# Storage is in-memory per backend instance.
THROTTLE_TTL_MS=60000
# Default requests per window for all routes.
THROTTLE_LIMIT=100
# POST /payments/verify per organization per window.
PAYMENT_VERIFY_RATE_LIMIT=60
# POST /payments/verify-image per organization per window (stricter: uploads
# a file and may trigger upstream OCR + verification calls).
PAYMENT_VERIFY_IMAGE_RATE_LIMIT=30

# Public base URL used to build payment-account QR deep links
# (https://<host>/qr/v1/<publicId>). Set this to the publicly reachable
# HTTPS origin that serves the app — never a placeholder. When unset, the
# origin of the incoming API request is used instead.
QR_PUBLIC_BASE_URL=""

# GET /qr/resolve/:publicId requests per window (per organization). Bounds
# attempts to enumerate QR identifiers.
QR_RESOLVE_RATE_LIMIT=60

# Server-side secret for keyed HMAC-SHA-256 hashing of receiving-account
# numbers (Stage 1). REQUIRED in production (startup fails without it).
# Generate with: openssl rand -base64 48
# NEVER expose this to the Flutter app. Back it up with database backups —
# stored hashes are unusable without it. To rotate: set the NEW secret and
# re-run scripts/backfill-account-hashes.ts.
ACCOUNT_HASH_SECRET=

# Check.et Payment Verification API (ACTIVE provider)
# Business account + API key required: https://check.et/register?type=business
CHECK_ET_BASE_URL="https://api.check.et"
CHECK_ET_API_KEY=""

# [LEGACY - Veritas / verify.leul.et] Retired from active verification.
# Kept for reference/rollback only until the Check.et migration is verified.
# VERIFY_API_KEY="replace-with-verify-api-key"
# VERIFY_LEUL_ET_BASE_URL="https://verifyapi.leulzenebe.pro"

# Payment verification bypass (DEV ONLY, NEVER enable in production).
# When "true", payments are approved WITHOUT calling the upstream Check.et
# API. This is a fraud vector and is rejected by the application in production.
# Client requests CANNOT control this value.
SKIP_PRIMARY_VERIFICATION="false"
