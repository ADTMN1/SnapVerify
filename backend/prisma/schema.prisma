generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PaymentAccount {
  id                String            @id @default(uuid())
  // Opaque, stable public identifier used in the account's QR deep link
  // (/qr/v1/<publicId>). Generated server-side on creation, unique per
  // account, and never derived from the bank account number so a QR code
  // cannot be reversed into sensitive banking data.
  publicId          String            @unique
  organizationId    String
  provider          PaymentProvider
  accountNumber     String?
  // SHA-256 hex of the normalized (whitespace/dash-stripped) account number.
  // New matching paths compare against this hash; the legacy plaintext column
  // is retained only until a backfill + deprecation migration is executed.
  accountNumberHash String?
  suffix            String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  accountHolderName String?
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verificationLogs  VerificationLog[] @relation("MatchedVerificationLog")

  @@unique([organizationId, provider, branchId])
  @@map("payment_accounts")
}

model Branch {
  id              String                   @id @default(uuid())
  organizationId  String
  name            String
  address         String?
  latitude        Decimal?
  longitude       Decimal?
  phone           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitations     Invitation[]
  paymentAccounts PaymentAccount[]
  userAssignments UserBusinessAssignment[]

  @@map("branches")
}

model Organization {
  id               String                   @id @default(uuid())
  name             String
  type             String
  phone            String
  email            String?
  address          String?
  city             String?
  country          String?
  logoUrl          String?
  subscriptionPlan String?
  status           String                   @default("active")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  activityLogs     ActivityLog[]
  branches         Branch[]
  invitations      Invitation[]
  paymentAccounts  PaymentAccount[]
  payments         Payment[]
  subscriptions    Subscription[]
  userAssignments  UserBusinessAssignment[]
  verificationLogs VerificationLog[]

  @@map("organizations")
}

model User {
  id               String                   @id @default(uuid())
  fullName         String?
  phone            String                   @unique
  email            String?
  passwordHash     String?
  status           String                   @default("active")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  activityLogs     ActivityLog[]
  payments         Payment[]
  refreshTokens    RefreshToken[]
  userAssignments  UserBusinessAssignment[]
  verificationLogs VerificationLog[]

  @@map("users")
}

model UserBusinessAssignment {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  branchId       String?
  role           Role
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  devices        Device[]
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_business_assignments")
}

model Invitation {
  id             String       @id @default(uuid())
  phone          String
  organizationId String
  branchId       String?
  role           Role
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  token          String       @unique
  expiresAt      DateTime
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  attempts  Int      @default(0)
  otpHash   String

  @@map("otp_codes")
}

model RefreshToken {
  id             String   @id @default(uuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  deviceInfo     String?
  ipAddress      String?
  createdAt      DateTime @default(now())
  organizationId String
  role           String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Device {
  id                String                 @id @default(uuid())
  deviceFingerprint String
  deviceName        String?
  isActive          Boolean                @default(true)
  lastLoginAt       DateTime               @default(now())
  createdAt         DateTime               @default(now())
  userAssignmentId  String
  userAssignment    UserBusinessAssignment @relation(fields: [userAssignmentId], references: [id], onDelete: Cascade)

  @@unique([userAssignmentId, deviceFingerprint])
  @@map("devices")
}

model Payment {
  id                     String            @id @default(uuid())
  organizationId         String
  userId                 String?
  amount                 Decimal
  currency               String            @default("ETB")
  paymentMethod          String
  transactionId          String
  // Deterministic normalization of transactionId (uppercase, whitespace and
  // separator-stripped). Null for legacy/empty references. Backed by a unique
  // constraint with organizationId for database-level duplicate protection.
  normalizedTransactionId String?
  senderName             String?
  receiverName           String?
  status                 PaymentStatus
  riskScore              Int?
  rawData                Json?
  // Which verification VENDOR produced this row: 'check_et' for new
  // verification attempts, null for legacy Veritas-era rows. Historical
  // Veritas records are never rewritten.
  verificationProvider   String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?             @relation(fields: [userId], references: [id])
  verificationLogs       VerificationLog[]

  @@unique([organizationId, normalizedTransactionId])
  @@index([organizationId, createdAt])
  @@map("payments")
}

model VerificationLog {
  id                      String           @id @default(uuid())
  organizationId          String?
  paymentId               String?
  userId                  String?
  action                  String
  reason                  String?
  riskScore               Int?
  createdAt               DateTime         @default(now())
  matchedAccountNumber    String?
  matchedBranchId         String?
  matchedPaymentAccountId String?
  matchedProvider         PaymentProvider?
  matchedSuffix           String?
  matchedPaymentAccount   PaymentAccount?  @relation("MatchedVerificationLog", fields: [matchedPaymentAccountId], references: [id])
  organization            Organization?    @relation(fields: [organizationId], references: [id])
  payment                 Payment?         @relation(fields: [paymentId], references: [id])
  user                    User?            @relation(fields: [userId], references: [id])

  @@map("verification_logs")
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String
  planName       String
  status         SubscriptionStatus
  startDate      DateTime
  endDate        DateTime?
  maxUsers       Int?
  maxDevices     Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
}

enum VerificationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  FAILED
}

enum PaymentProvider {
  CBE
  TELEBIRR
  DASHEN
  ABYSSINIA
  CBEBIRR
  M_PESA
}
